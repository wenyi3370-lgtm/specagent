# Optional. Without this key, SpecAgent compiles specs with the deterministic demo compiler.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Optional external agent adapter. Keep blank to use the built-in demo agent.
# The endpoint is backend-configured only (never accepted from the browser) — SSRF safety.
TARGET_AGENT_URL=
TARGET_AGENT_TOKEN=
TARGET_AGENT_TIMEOUT=30

# Demo agent variant used when no explicit variant is requested: vulnerable (default) | patched
DEMO_AGENT_VARIANT=vulnerable

# Run persistence. A file path uses SQLite (default ./specagent.db); a full
# SQLAlchemy URL uses that backend, e.g.:
#   SPECAGENT_DB=postgresql+psycopg://specagent:specagent@localhost:5432/specagent
SPECAGENT_DB=

# Project-level concurrency limit across concurrent runs (default 8)
SPECAGENT_PROJECT_CONCURRENCY=8

# Comma-separated endpoint hostname allowlist for the HTTP adapter (v0.7 SSRF
# guard). Empty = only the backend-configured TARGET_AGENT_URL is reachable.
# Example: SPECAGENT_ALLOWED_HOSTS=agent.example.com,staging.agent.internal
SPECAGENT_ALLOWED_HOSTS=

# Log level for the API server (DEBUG|INFO|WARNING)
LOG_LEVEL=INFO
